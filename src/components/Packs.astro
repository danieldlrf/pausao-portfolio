---
// --- CONTROL DE DESCUENTOS (mismo valor que en servicios.astro) ---
const DISCOUNT = 25;
const PACK_EXTRA_DISCOUNT = 10;

function priceAfter(base: number, discount: number, extraPercent = 0) {
  if (discount <= 0) return base;
  let price = base * (1 - discount / 100);
  if (extraPercent > 0) price = price * (1 - extraPercent / 100);
  return Math.round(price);
}

function formatPrice(n: number) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
}

const featuredPacks = [
  { category: "MARKETING", name: "Identidad esencial", includes: ["Logotipo principal, secundario e isotipo (PNG, JPG, SVG, EPS)", "Sistema cromático", "Sistema tipográfico", "Mini guía de identidad en PDF"], base: 850, extra: 0, discount: true, recommended: false },
  { category: "INTEGRADO", name: "Lanzamiento digital", includes: ["Entregables completos del paquete 1 (Identidad esencial)", "Entregables paquete 3 (Web corporativa funcional)"], base: 2250, extra: PACK_EXTRA_DISCOUNT, discount: true, recommended: false },
  { category: "INTEGRADO", name: "Transformación total PAUSAO", includes: ["Entregables completos del paquete 2 (Universo visual)", "Entregables paquete 4 (Web avanzada, automatizaciones y ERP)", "Opcion a tienda online si se requiere"], base: 6250, extra: PACK_EXTRA_DISCOUNT, discount: true, recommended: true },
];
---

<section id="packs">
  {DISCOUNT > 0 && (
    <div class="launchBadge">
      <span class="launchBadgeIcon">🔥</span>
      <span class="launchBadgeText">
        Oferta de lanzamiento
        <strong>{DISCOUNT}% OFF</strong>
      </span>
    </div>
  )}

  <p class="subtitles">PAQUETES</p>
  <p class="packsSubtitle">Tres formas de empezar</p>
  <div class="cardContainer">
    {
      featuredPacks.map((pack) => {
        const appliedDiscount = pack.discount ? DISCOUNT : 0;
        const finalPrice = priceAfter(pack.base, appliedDiscount, pack.extra);
        return (
          <div class="card" id={pack.recommended ? "c3" : undefined}>
            {pack.recommended && <span class="badge">Recomendado</span>}
            <div class="container">
              <p>{pack.category}</p>
              <div class="textodistinto">
                <h4>
                  <b>{pack.name}</b>
                </h4>
              </div>
              <ul class="lista-colores">
                {pack.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <div class="textodistinto">
                {appliedDiscount > 0 ? (
                  <h4>
                    <span class="priceOld">DESDE {formatPrice(pack.base)}€</span>{" "}
                    <b class="priceNew">DESDE {formatPrice(finalPrice)}€</b>
                  </h4>
                ) : (
                  <h4>
                    <b>DESDE {formatPrice(pack.base)}€</b>
                  </h4>
                )}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
<div class="linkcontainer">
  <p><a class="link" href="/services">VER MAS PAQUETES &rarr;</a></p>
</div>