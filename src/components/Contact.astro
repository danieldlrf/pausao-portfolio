<script>
  const form = document.querySelector("#contact-form");
  const message = document.querySelector("#form-message");
  const submitBtn = document.querySelector("#submit-btn");
  const btnText = submitBtn?.querySelector(".btnText");
  const spinner = submitBtn?.querySelector(".spinner");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    submitBtn.disabled = true;
    btnText.hidden = true;
    spinner.hidden = false;

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: {
          Accept: "application/json",
        },
      });

      if (response.ok) {
        message!.textContent = "Mensaje recibido :)";
        form.reset();
      } else {
        message!.textContent = "Ha ocurrido un problema. Inténtalo de nuevo.";
      }
    } catch (error) {
      message!.textContent = "No hemos podido enviar el mensaje.";
    } finally {
      submitBtn.disabled = false;
      btnText.hidden = false;
      spinner.hidden = true;
    }
  });
</script>

<section id="contact">
  <p class="contactTitle">¿hablamos de tu proyecto?</p>
  <p class="contactText">
    Abrimos ya mismo — escríbenos y sé de los primeros en trabajar
    con nosotros.
  </p>
  <form
    id="contact-form"
    class="contactForm"
    action="https://formspree.io/f/xwlerjdb"
    method="POST"
  >
    <label class="field">
      Nombre
      <input type="text" name="name" required />
    </label>

    <label class="field">
      Empresa
      <input type="text" name="business" required />
    </label>

    <label class="field">
      Correo
      <input type="email" name="email" required />
    </label>

    <label class="field">
      Telefono
      <input type="tel" name="phone" required />
    </label>

    <label class="field fieldFull">
      Asunto
      <input type="text" name="matter" required />
    </label>

    <label class="field fieldFull">
      Cuentanos un poco más:
      <textarea name="comment"></textarea>
    </label>

    <label class="fieldCheckbox fieldFull">
      <input type="checkbox" name="privacy" id="privacy" required />
      He leído y acepto la
      <a target="_blank" rel="noopener" href="../privacy-policy">Política de Privacidad</a>
    </label>

    <button type="submit" class="btn btn-oscuro fieldFull" id="submit-btn">
  <span class="btnText">Enviar</span>
  <span class="spinner" hidden></span>
</button>
  </form>
  <p id="form-message" class="formMessage" aria-live="polite"></p>
</section>