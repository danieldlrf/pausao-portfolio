---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
const { title = "PAUSAO" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />

    <title>PAUSAO — Web, ERP y branding para tu negocio</title>
    <meta name="description"
      content="Rediseñamos, automatizamos e impulsamos las ventas de tu pyme con web, sistema ERP y marca, todo en un mismo servicio."/>

    <meta property="og:title" content="PAUSAO — Tu negocio, sin correr" />
    <meta property="og:description" content="Web, sistema de gestión y rebranding para pymes."/>
    <meta property="og:image" content="/logo/logoWeb.png" />
    <meta property="og:url" content="https://pausao.onrender.com" />
    <title>{title}</title>
  </head>

  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
