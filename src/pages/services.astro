---
import Layout from "../layouts/Layout.astro";
import PriceTag from "../components/PriceTag.astro";

// --- CONTROL DE DESCUENTOS ---
// Pon DISCOUNT a 0 para desactivar todos los descuentos y mostrar precios finales sin tachar.
const DISCOUNT = 25; // % de descuento general de lanzamiento
const PACK_EXTRA_DISCOUNT = 10; // % extra SOLO para los 3 packs de Marketing

function priceAfter(base: number, discount: number, extraPercent = 0) {
  if (discount <= 0) return base;
  let price = base * (1 - discount / 100);
  if (extraPercent > 0) price = price * (1 - extraPercent / 100);
  return Math.round(price);
}

function formatPrice(n: number) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
}

const packs = [
  { category: "MARKETING", name: "Identidad esencial", includes: ["Logotipo principal, secundario e isotipo (PNG, JPG, SVG, EPS)", "Sistema cromático", "Sistema tipográfico", "Mini guía de identidad en PDF"], base: 850, extra: 0, discount: true },
  { category: "MARKETING", name: "Universo visual y dirección de arte", includes: ["Todo lo del paquete 1", "Brandbook (manual de marca completo)", "Concepto creativo de campaña (moodboard y key visual)", "3 aplicaciones graficas a elegir (tarjetas, menú, cartelería, papelería o packaging)"], base: 1450, extra: 0, discount: true },
  { category: "INFORMÁTICA", name: "Web corporativa funcional", includes: ["Diseño UI/UX adaptado a la identidad", "Desarrollo a medida responsive (móviles y tablets)", "SEO técnico", "Setup de infraestructura (dominio, hosting y SSL)"], base: 1400, extra: 0, discount: true },
  { category: "INFORMÁTICA", name: "Web avanzada, automatizaciones y ERP", includes: ["Todo lo del paquete 3", "Desarrollo web a medida (enfocado a captación o servicios)", "Automatización base para flujos operativos (n8n / bonita (precio extra))", "Configuración inicial del ERP Odoo para la gestion del negocio y seguirdad de copias automatizadas", "Sistema CRM", "Opcion a añadir e-commerce (extra)"], base: 2900, extra: 0, discount: true },
  { category: "INTEGRADO", name: "Lanzamiento digital", includes: ["Entregables completos del paquete 1 (Identidad esencial)"," Entregables paquete 3 (Web corporativa funcional)"], base: 2250, extra: PACK_EXTRA_DISCOUNT, discount: true },
  { category: "INTEGRADO", name: "Transformación total PAUSAO", includes: ["Entregables completos del paquete 2 (Universo visual)"," Entregables paquete 4 (Web avanzada, automatizaciones y ERP)", "Opcion a tienda online si se requiere"], base: 6250, extra: PACK_EXTRA_DISCOUNT, discount: true },
];

const redes = [
  {
    name: "Kit esencial",
    base: 225,
    discount: false,
    recommended: false,
    includes: ["Qué incluye 1", "Qué incluye 2", "Qué incluye 3"],
  },
  {
    name: "Kit completo",
    base: 375,
    discount: true,
    recommended: true,
    includes: ["Qué incluye 1", "Qué incluye 2", "Qué incluye 3", "Qué incluye 4"],
  },
  {
    name: "Kit pro",
    base: 595,
    discount: true,
    recommended: false,
    includes: ["Qué incluye 1", "Qué incluye 2", "Qué incluye 3", "Qué incluye 4", "Qué incluye 5"],
  },
];
---

<Layout
  title="Paquetes — PAUSAO"
  description="Paquetes de branding, web y sistemas ERP para pymes en Sevilla."
>
  <section class="servicesHero">
    {
      DISCOUNT > 0 && (
        <div class="launchBadge">
          <span class="launchBadgeIcon">🔥</span>
          <span class="launchBadgeText">
            Oferta de lanzamiento
            <strong>{DISCOUNT}% OFF</strong>
          </span>
        </div>
      )
    }
    <p class="subtitles">Paquetes</p>
    <h1 class="servicesTitle">Nuestros servicios</h1>
    <h5>Selecciona los servicios para tu proyecto (precios sin IVA)</h5>
  </section>

  <div class="wizard" id="wizard">
    <div class="wizardTrack" id="wizardTrack">
      <!-- PASO 1: PACKS (varios) -->
      <div class="wizardPanel" data-step="0">
        <section class="servicesPacks" id="packs-section">
          <div class="cardContainer cardContainerWrap">
            {
              packs.map((pack) => {
                const appliedDiscount = pack.discount ? DISCOUNT : 0;
                const finalPrice = priceAfter(pack.base, appliedDiscount, pack.extra);
                return (
                  <div class="card">
                    <div class="container">
                      <label class="packSelect">
                        <input
                          type="checkbox"
                          class="packRadio"
                          name="services"
                          value={pack.name}
                          form="custom-pack-form"
                          autocomplete="off"
                          data-price={finalPrice}
                        />
                        <span>Elegir este pack</span>
                      </label>
                      <p>{pack.category}</p>
                      <div class="textodistinto">
                        <h4>
                          <b>{pack.name}</b>
                        </h4>
                      </div>
                      <ul class="lista-colores">
                        {pack.includes.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                      <div class="textodistinto">
                        {appliedDiscount > 0 ? (
                          <h4>
                            <span class="priceOld">DESDE {formatPrice(pack.base)}€</span>{" "}
                            <b class="priceNew">DESDE {formatPrice(finalPrice)}€</b>
                          </h4>
                        ) : (
                          <h4>
                            <b>DESDE {formatPrice(pack.base)}€</b>
                          </h4>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </section>
      </div>

      <!-- PASO 2: REDES SOCIALES (solo 1) -->
      <div class="wizardPanel inactive" data-step="1">
        <section class="redesSection" id="redes-section">
          <p class="subtitles">Paso 2</p>
          <h2 class="redesTitle">Gestión de redes sociales</h2>
          <p class="redesText">Ventaja exclusiva por tener un proyecto activo con PAUSAO: 20% de descuento directo aplicable en los kits completo y pro</p>

          <div class="redesOptions">
            {
              redes.map((r) => {
                const appliedDiscount = r.discount ? DISCOUNT : 0;
                return (
                  <label class="redesCard">
                    {r.recommended && <span class="redesBadge">Recomendado</span>}
                    <input
                      type="radio"
                      class="redesRadio"
                      name="redes"
                      value={r.name}
                      form="custom-pack-form"
                      autocomplete="off"
                      data-price={priceAfter(r.base, appliedDiscount)}
                    />
                    <h3 class="redesCardTitle">{r.name}</h3>
                    <ul class="redesList">
                      {r.includes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    <div class="redesPrice">
                      <PriceTag base={r.base} discount={appliedDiscount} />
                    </div>
                  </label>
                );
              })
            }
          </div>

          <div class="redesSkipRow">
            <label class="btn btn-linea redesSkip">
              <input
                type="radio"
                class="redesRadio"
                name="redes"
                value="No, gracias"
                form="custom-pack-form"
                autocomplete="off"
                data-price="0"
              />
              <span>No, gracias</span>
            </label>
          </div>

          <button type="button" class="btn btn-linea backBtn" data-back="0">
            ← Volver
          </button>
        </section>
      </div>

      <!-- PASO 3: FORMULARIO -->
      <div class="wizardPanel inactive" data-step="2">
        <section class="customPack" id="form-section">
          <p class="subtitles">Paso 3</p>
          <h2 class="redesTitle">Datos de contacto</h2>
          <p class="redesText">Demos el primer paso. Completa estos datos para que podamos preparar tu propuesta a medida y agendar nuestra primera cita.</p>
          <form
            id="custom-pack-form"
            class="contactForm customPackForm"
            action="https://formspree.io/f/xwlerjdb"
            method="POST"
            autocomplete="off"
          >
            <label class="field">
              Nombre
              <input type="text" name="name" required />
            </label>
            <label class="field">
              Empresa
              <input type="text" name="business" required />
            </label>
            <label class="field">
              Correo
              <input type="email" name="email" required />
            </label>
            <label class="field">
              Teléfono
              <input type="tel" name="phone" required />
            </label>
            <label class="field fieldFull">
              Asunto
              <input
                type="text"
                name="matter"
                value="Paquete personalizado"
                required
              />
            </label>
            <label class="field fieldFull">
              Cuéntanos un poco más:
              <textarea name="comment"></textarea>
            </label>
            <label class="fieldCheckbox fieldFull">
              <input type="checkbox" name="privacy" id="privacy-pack" required />
              He leído y acepto la
              <a target="_blank" rel="noopener" href="/privacy-policy"
                >Política de Privacidad</a
              >
            </label>
            <input
              type="hidden"
              name="estimated_price"
              id="estimated-price-field"
              value="0"
            />
            <div class="customPackActions fieldFull">
              <button type="button" class="btn btn-linea backBtn" data-back="1">
                ← Volver
              </button>
              <button type="submit" class="btn btn-oscuro">
                <span class="btnText">Enviar selección</span>
                <span class="spinner" hidden></span>
              </button>
              <button type="button" class="btn btn-linea cancelPackFlow"
                >Cancelar</button
              >
            </div>
          </form>

          <p id="custom-pack-message" class="formMessage" aria-live="polite"></p>
        </section>
      </div>
    </div>
  </div>

  <!-- Botones fijos: solo se ve uno a la vez -->
  <section class="customPackToggle">
    <button type="button" class="btn btn-oscuro" id="togglePackForm">
      Haz tu presupuesto
    </button>
    <button type="button" class="btn btn-oscuro" id="nextBtn" hidden>
      Continuar →
    </button>
  </section>

  <section class="notSure">
    <p class="notSureTitle">¿No sabes muy bien qué necesitas?</p>
    <p class="notSureText">Escríbenos y te ayudamos a verlo juntos.</p>
    <div class="notSureActions">
      <a class="btn btn-oscuro" href="/#contact">Ir a contacto</a>
      <a class="btn btn-linea" href="tel:+34679681792">+34 679 681 792</a>
    </div>
  </section>

  <section class="policies">
    <p class="subtitles">Condiciones</p>
    <h2 class="policiesTitle">Formas de pago y condiciones</h2>

    <div class="policyGrid">
      <div class="policyBlock">
        <h3 class="policyHeading">Formas de pago</h3>
        <ul class="legalList">
          <li>Hasta 3.000€: pago 50% al inicio / 50% a la entrega final</li>
          <li>Más de 3.000€: pago 40% al inicio / 30% en la revision / 30% en la entrega final</li>
          <li>No se comienzara el trabajo hasta recibir el pago inicial</li>
        </ul>
      </div>

      <div class="policyBlock">
        <h3 class="policyHeading">Alcances y revisiones</h3>
        <ul class="legalList">
          <li>Se define un listado cerrado de entregables antes de empezar</li>
          <li>Incluye 2 rondas de revision de los entregables definidos sin coste adicional</li>
          <li>Cambios dentro de ese listado: sin cargo extra</li>
          <li>Los pagos iniciales actúan como reserva del proyecto y agenda, por lo que no son reembolsables</li>
        </ul>
      </div>

      <div class="policyBlock">
        <h3 class="policyHeading">Tiempos y entregas</h3>
        <ul class="legalList">
          <li>Materiales: El cliente deberá proporcionar los textos, imágenes de producto y material legal necesario antes del inicio del desarrollo</li>
          <li>Plazo: Las fechas estimadas de entrega requieren que el cliente cumpla con los tiempos acordados para enviar su feedback</li>
          <li>Soporte web: Todos los desarrollos incluyen 15 dias de soporte técnico gratuito tras el lanzamiento para garantizar su perfecto funcionamiento (no incluye nuevo desarrollo o cambios de diseño)</li>
          <li>Validez: Las propuestas y presupuestos presentados tienen una validez de 15 días</li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    const toggleBtn = document.querySelector("#togglePackForm") as HTMLButtonElement;
    const nextBtn = document.querySelector("#nextBtn") as HTMLButtonElement;
    const cancelBtns = document.querySelectorAll<HTMLButtonElement>(".cancelPackFlow");
    const backBtns = document.querySelectorAll<HTMLButtonElement>(".backBtn");
    const form = document.querySelector("#custom-pack-form") as HTMLFormElement;
    const message = document.querySelector("#custom-pack-message") as HTMLElement;
    const servicesPacks = document.querySelector(".servicesPacks") as HTMLElement;
    const wizard = document.querySelector("#wizard") as HTMLElement;
    const track = document.querySelector("#wizardTrack") as HTMLElement;
    const panels = Array.from(document.querySelectorAll<HTMLElement>(".wizardPanel"));
    const submitBtn = form?.querySelector("button[type=submit]") as HTMLButtonElement;
    const btnText = submitBtn?.querySelector(".btnText") as HTMLElement;
    const spinner = submitBtn?.querySelector(".spinner") as HTMLElement;
    const estimatedPriceField = document.querySelector(
      "#estimated-price-field",
    ) as HTMLInputElement;

    let currentStep = 0;
    let collapseTimer: number | undefined;

    function scrollToWizard() {
      setTimeout(() => wizard.scrollIntoView({ behavior: "smooth", block: "start" }), 50);
    }

    function updateEstimatedPrice() {
      if (!estimatedPriceField) return;
      const checked = document.querySelectorAll<HTMLInputElement>(
        'input[name="services"]:checked, input[name="redes"]:checked',
      );
      let total = 0;
      checked.forEach((input) => {
        total += Number(input.dataset.price || 0);
      });
      estimatedPriceField.value = String(total);
    }

    // El botón "Continuar" solo aparece si el paso actual tiene algo elegido
    function updateNext() {
      const customizing = servicesPacks.classList.contains("customizing");
      const hasPack = !!document.querySelector('input[name="services"]:checked');
      const hasRedes = !!document.querySelector('input[name="redes"]:checked');
      nextBtn.hidden = !(
        customizing &&
        ((currentStep === 0 && hasPack) || (currentStep === 1 && hasRedes))
      );
    }

    function goToStep(step: number, animate = true) {
      currentStep = step;
      window.clearTimeout(collapseTimer);

      // El panel de destino tiene que ocupar espacio antes de deslizar
      panels[step].classList.remove("inactive");

      if (!animate) track.style.transition = "none";
      track.style.transform = `translateX(-${step * 100}%)`;

      // Cuando termina el deslizamiento, colapsamos los demás para que
      // la página no tenga la altura del panel más alto
      const collapseOthers = () =>
        panels.forEach((p, i) => p.classList.toggle("inactive", i !== step));

      if (animate) {
        collapseTimer = window.setTimeout(collapseOthers, 450);
      } else {
        collapseOthers();
        track.getBoundingClientRect(); // fuerza reflow
        track.style.transition = "";
      }

      updateNext();
    }

    function resetFlow() {
      document
        .querySelectorAll<HTMLInputElement>('input[name="services"], input[name="redes"]')
        .forEach((input) => (input.checked = false));
      form.reset();
      updateEstimatedPrice();
      message.textContent = "";
      servicesPacks.classList.remove("customizing");
      toggleBtn.hidden = false;
      goToStep(0);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    // Igual que resetFlow pero sin animación ni scroll (carga de página)
    function clearOnLoad() {
      document
        .querySelectorAll<HTMLInputElement>('input[name="services"], input[name="redes"]')
        .forEach((input) => (input.checked = false));
      form.reset();
      updateEstimatedPrice();
      message.textContent = "";
      servicesPacks.classList.remove("customizing");
      toggleBtn.hidden = false;
      goToStep(0, false);
    }

    // "pageshow" se dispara en la carga normal, en recargas y al volver con "atrás" (bfcache)
    window.addEventListener("pageshow", clearOnLoad);

    // Botón "Haz tu presupuesto": activa la selección de packs
    toggleBtn?.addEventListener("click", () => {
      servicesPacks.classList.add("customizing");
      toggleBtn.hidden = true;
      updateNext();
      scrollToWizard();
    });

    // Botón "Continuar"
      nextBtn?.addEventListener("click", () => {
      if (currentStep < 2) {
        goToStep(currentStep + 1);
      }
    });

    // Botones "Volver"
    backBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        goToStep(Number(btn.dataset.back));
      }),
    );

    // Al marcar/desmarcar algo: recalcula precio y decide si se muestra "Continuar"
    document.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (!target) return;

      if (target.name === "services" || target.name === "redes") {
        updateEstimatedPrice();
        updateNext();
      }
    });

    cancelBtns.forEach((btn) => btn.addEventListener("click", resetFlow));

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      submitBtn.disabled = true;
      btnText.hidden = true;
      spinner.hidden = false;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          resetFlow();
          message.textContent = "Mensaje recibido :)";
        } else {
          message.textContent = "Ha ocurrido un problema. Inténtalo de nuevo.";
        }
      } catch (error) {
        message.textContent = "No hemos podido enviar el mensaje.";
      } finally {
        submitBtn.disabled = false;
        btnText.hidden = false;
        spinner.hidden = true;
      }
    });
  </script>
</Layout>