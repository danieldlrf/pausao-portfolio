      class="contactForm customPackForm"
      action="https://formspree.io/f/xwlerjdb"
      method="POST"
      hidden
    >
      <label class="field">
        Nombre
        <input type="text" name="name" required />
      </label>
      <label class="field">
        Empresa
        <input type="text" name="business" required />
      </label>
      <label class="field">
        Correo
        <input type="email" name="email" required />
      </label>
      <label class="field">
        Teléfono
        <input type="tel" name="phone" required />
      </label>
      <label class="field fieldFull">
        Asunto
        <input
          type="text"
          name="matter"
          value="Paquete personalizado"
          required
        />
      </label>
      <label class="field fieldFull">
        Cuéntanos un poco más:
        <textarea name="comment"></textarea>
      </label>
      <label class="fieldCheckbox fieldFull">
        <input type="checkbox" name="privacy" id="privacy-pack" required />
        He leído y acepto la
        <a target="_blank" rel="noopener" href="/privacy-policy"
          >Política de Privacidad</a
        >
      </label>
      <div class="customPackActions fieldFull">
        <button type="submit" class="btn btn-oscuro">
          <span class="btnText">Enviar selección</span>
          <span class="spinner" hidden></span>
        </button>
        <button type="button" class="btn btn-linea" id="cancelPackForm"
          >Cancelar</button
        >
      </div>
    </form>

    <p id="custom-pack-message" class="formMessage" aria-live="polite"></p>
  </section>

  <section class="notSure">
    <p class="notSureTitle">¿No sabes muy bien qué necesitas?</p>
    <p class="notSureText">Escríbenos y te ayudamos a verlo juntos.</p>
    <div class="notSureActions">
      <a class="btn btn-oscuro" href="/#contact">Ir a contacto</a>
      <a class="btn btn-linea" href="tel:+34679681792">+34 679 681 792</a>
    </div>
  </section>

  <section class="policies">
    <p class="subtitles">Condiciones</p>
    <h2 class="policiesTitle">Formas de pago y cancelaciones</h2>

    <div class="policyGrid">
      <div class="policyBlock">
        <h3 class="policyHeading">Formas de pago</h3>
        <ul class="legalList">
          <li>Hasta 3.000€: pago 50% al inicio / 50% a la entrega</li>
          <li>Más de 3.000€: pago en 3 partes</li>
        </ul>
      </div>

      <div class="policyBlock">
        <h3 class="policyHeading">Cancelaciones</h3>
        <ul class="legalList">
          <li>Se define un listado de entregables antes de empezar</li>
          <li>Incluye 2 rondas de cambios sin coste adicional</li>
          <li>Cambios dentro de ese listado: sin cargo extra</li>
          <li>El dinero ya pagado no se devuelve en caso de cancelación</li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    const toggleBtn = document.querySelector("#togglePackForm");
    const cancelBtn = document.querySelector("#cancelPackForm");
    const form = document.querySelector("#custom-pack-form") as HTMLFormElement;
    const message = document.querySelector("#custom-pack-message");
    const servicesList = document.querySelector(".servicesList");
    const servicesPacks = document.querySelector(".servicesPacks");
    const submitBtn = form?.querySelector(
      "button[type=submit]",
    ) as HTMLButtonElement;
    const btnText = submitBtn?.querySelector(".btnText") as HTMLElement;
    const spinner = submitBtn?.querySelector(".spinner") as HTMLElement;

    toggleBtn?.addEventListener("click", () => {
      form.hidden = false;
      toggleBtn.hidden = true;
      servicesList?.classList.add("customizing");
      servicesPacks?.classList.add("customizing");
      window.scrollBy({ top: -120, behavior: "smooth" });
    });

    cancelBtn?.addEventListener("click", () => {
      form.reset();
      form.hidden = true;
      toggleBtn.hidden = false;
      message!.textContent = "";
      servicesList?.classList.remove("customizing");
      servicesPacks?.classList.remove("customizing");
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      submitBtn.disabled = true;
      btnText.hidden = true;
      spinner.hidden = false;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          message!.textContent = "Mensaje recibido :)";
          form.reset();
          form.hidden = true;
          toggleBtn!.hidden = false;
          servicesList?.classList.remove("customizing");
          servicesPacks?.classList.remove("customizing");
          window.scrollTo({ top: 0, behavior: "smooth" });
        } else {
          message!.textContent = "Ha ocurrido un problema. Inténtalo de nuevo.";
        }
      } catch (error) {
        message!.textContent = "No hemos podido enviar el mensaje.";
      } finally {
        submitBtn.disabled = false;
        btnText.hidden = false;
        spinner.hidden = true;
      }
    });
  </script>
</Layout>